@{
    ViewData["Title"] = "Cadastrar Autor";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h2 class="text-success mb-4">Cadastrar Novo Autor</h2>
            
            <form>
                <div class="mb-3">
                    <label class="form-label fw-bold">Nome Completo</label>
                    <input type="text" class="form-control" placeholder="Ex: Antoine de Saint-Exupéry">
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Data de Nascimento</label>
                    <input type="date" class="form-control">
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Nacionalidade</label>
                    <input type="text" class="form-control" placeholder="Ex: Francês">
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Biografia</label>
                    <textarea class="form-control" rows="5" placeholder="Escreva uma breve biografia do autor..."></textarea>
                </div>

                <div class="mt-4">
                    <button type="button" class="btn btn-success px-4">Salvar Autor</button>
                    <a asp-controller="Biblioteca" asp-action="Index" class="btn btn-outline-secondary px-4">Voltar</a>
                </div>
            </form>
        </div>
    </div>
    //form method= post aspaction= CriarLivro aspController = Biblioteca form

</div>