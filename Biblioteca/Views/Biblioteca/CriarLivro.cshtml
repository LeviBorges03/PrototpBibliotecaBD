@model Livro;

@{
    ViewData["Title"] = "Cadastrar Livro";
}

@section Styles {
    <link rel="stylesheet" href="~/css/forms.css" />
}

<div class="container page-wrapper">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="form-container">
                <h2 class="form-title">Cadastrar Novo Livro</h2>
                <form method="post" asp-action="CriarLivro" asp-controller="Biblioteca">
                    <div class="mb-3">
                        <label class="form-label">Título do Livro</label>
                        <input asp-for="Titulo" type="text" class="form-control" placeholder="Ex: O Pequeno Príncipe">
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Ano de Publicação</label>
                            <input asp-for="DataPublicacao" type="date" class="form-control" placeholder="Ex: 1943">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Gênero</label>
                            <input asp-for="Genero" type="text" class="form-control" placeholder="Ex: Fábula">
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Número de Páginas</label>
                            <input asp-for="NumPaginas" type="number" class="form-control" placeholder="Ex: 96">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Autor</label>
                            <input asp-for="Autor" type="text" class="form-control" placeholder="Ex: Antoine de Saint-Exupéry">
                        </div>
                    </div>

                    <div class="mt-4 d-flex gap-3">
                        <button type="submit" class="btn btn-primary-custom">Salvar Livro</button>
                        <a asp-controller="Biblioteca" asp-action="Index" class="btn btn-secondary-custom">Voltar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
