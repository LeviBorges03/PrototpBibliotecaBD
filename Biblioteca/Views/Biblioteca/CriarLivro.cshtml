@model Biblioteca.Models.Livro

@{
    ViewData["Title"] = "Cadastrar Livro";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm mt-5 mb-5" style="border-radius: 20px;">
            <div class="card-body p-4">
                <h2 class="text-center mb-4 text-primary fw-bold">Cadastro de Livro</h2>

                <form asp-controller="Biblioteca" asp-action="CriarLivro" method="post">
                    <div class="mb-3">
                        <label asp-for="Titulo" class="form-label">Título do Livro</label>
                        <input asp-for="Titulo" type="text" class="form-control" placeholder="Digite o título do livro">
                        <span asp-validation-for="Titulo" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Autor" class="form-label">Autor</label>
                        <input asp-for="Autor" type="text" class="form-control" placeholder="Digite o nome do autor">
                        <span asp-validation-for="Autor" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Genero" class="form-label">Gênero</label>
                        <input asp-for="Genero" type="text" class="form-control" placeholder="Digite o gênero">
                        <span asp-validation-for="Genero" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NumPaginas" class="form-label">Número de Páginas</label>
                        <input asp-for="NumPaginas" type="number" class="form-control" placeholder="Digite o número de páginas">
                        <span asp-validation-for="NumPaginas" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DataPublicacao" class="form-label">Data de Publicação</label>
                        <input asp-for="DataPublicacao" type="date" class="form-control">
                        <span asp-validation-for="DataPublicacao" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CorCapa" class="form-label">Cor da Capa (Hex)</label>
                        <input asp-for="CorCapa" type="color" class="form-control form-control-color" title="Escolha a cor da capa">
                        <span asp-validation-for="CorCapa" class="text-danger"></span>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary fw-bold p-2" style="border-radius: 10px;">Cadastrar Livro</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
