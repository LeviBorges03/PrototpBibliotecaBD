@model Biblioteca.Models.Autor

@{
    ViewData["Title"] = "Cadastrar Autor";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm mt-5">
            <div class="card-body p-4">
                <h2 class="text-center mb-4" style="color: var(--primary); font-weight: bold;">Cadastro de Autor</h2>

                <form asp-controller="Biblioteca" asp-action="CriarAutor" method="post">
                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label fw-bold">Nome do Autor</label>
                        <input asp-for="Nome" class="form-control" placeholder="Digite o nome do autor" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="DataNascimento" class="form-label fw-bold">Data de Nascimento</label>
                        <input asp-for="DataNascimento" type="date" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Biografia" class="form-label fw-bold">Biografia</label>
                        <textarea asp-for="Biografia" class="form-control" rows="4" placeholder="Digite uma breve biografia" required></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-bold p-2" style="border-radius: 10px;">
                        Cadastrar Autor
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
