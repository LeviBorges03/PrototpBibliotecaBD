@model Autor;

@{
    ViewData["Title"] = "Cadastrar Autor";
}

@section Styles {
    <link rel="stylesheet" href="~/css/forms.css" />
}

<div class="container page-wrapper">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="form-container">
                <h2 class="form-title">Cadastrar Novo Autor</h2>
                <form method="post" asp-action="CriarAutor" asp-controller="Biblioteca">
                    <div class="mb-3">
                        <label class="form-label">Nome Completo</label>
                        <input asp-for="Nome" type="text" class="form-control" placeholder="Ex: Antoine de Saint-Exupéry">
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Data de Nascimento</label>
                            <input asp-for="DataNascimento" type="date" class="form-control">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Nacionalidade</label>
                            <input asp-for="Nacionalidade" type="text" class="form-control" placeholder="Ex: Francês">
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Biografia</label>
                        <textarea asp-for="Biografia" class="form-control" rows="5" placeholder="Escreva uma breve biografia do autor..."></textarea>
                    </div>

                    <div class="d-flex gap-3">
                        <button type="submit" class="btn btn-primary-custom">Salvar Autor</button>
                        <a asp-controller="Biblioteca" asp-action="Index" class="btn btn-secondary-custom">Voltar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
