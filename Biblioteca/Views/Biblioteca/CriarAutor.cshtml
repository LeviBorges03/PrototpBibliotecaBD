@{
    ViewData["Title"] = "Cadastrar Autor";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm mt-5 mb-5" style="border-radius: 20px;">
            <div class="card-body p-4">
                <h2 class="text-center mb-4 text-primary fw-bold">Cadastro de Autor</h2>

                <form asp-controller="Biblioteca" asp-action="CriarAutor" method="post">
                    <div class="mb-3">
                        <label class="form-label">Nome do Autor</label>
                        <input type="text" class="form-control" name="Nome" placeholder="Digite o nome do autor">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Nacionalidade</label>
                        <input type="text" class="form-control" name="Nacionalidade" placeholder="Digite a nacionalidade">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Data de Nascimento</label>
                        <input type="date" class="form-control" name="DataNascimento">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Biografia</label>
                        <textarea class="form-control" rows="4" name="Biografia" placeholder="Digite uma breve biografia"></textarea>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary fw-bold p-2" style="border-radius: 10px;">Cadastrar Autor</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
