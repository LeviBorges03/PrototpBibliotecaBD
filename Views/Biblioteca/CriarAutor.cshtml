@model Autor

@{
    ViewData["Title"] = "Cadastrar Autor";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5">
                    <h2 class="text-success mb-4 text-center">Cadastrar Novo Autor</h2>

                    <form method="post" asp-action="CriarAutorAsync" asp-controller="Biblioteca">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Nome Completo</label>
                            <input asp-for="Nome" type="text" class="form-control" placeholder="Ex: Antoine de Saint-Exupéry" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Data de Nascimento</label>
                            <input asp-for="DataNascimento" type="date" class="form-control" required>
                        </div>

                        <!-- Autor.cs does not have Nacionalidade property, omitting here -->

                        <div class="mb-3">
                            <label class="form-label fw-bold">Biografia</label>
                            <textarea asp-for="Biografia" class="form-control" rows="5" placeholder="Escreva uma breve biografia do autor..."></textarea>
                        </div>

                        <div class="mt-4 d-grid gap-2 d-md-flex justify-content-md-end">
                            <button type="submit" class="btn btn-success px-4">Salvar Autor</button>
                            <a asp-controller="Biblioteca" asp-action="Index" class="btn btn-outline-secondary px-4">Voltar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
